# AI Habit Coach environment template
# Mock mode works with no variables. Real AI requires one provider key below.
# Never commit a filled .env file.

# ---- Option A: EdgeOne Makers built-in models (recommended on EdgeOne) ----
# Create the key in EdgeOne Makers console -> Models -> API Key.
# Default routing: chat=@makers/deepseek-v4-flash, planning=@makers/deepseek-v4-pro.
MAKERS_MODELS_KEY=

# ---- Option B: DeepSeek or another compatible provider ----
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# ---- Option C: OpenAI-compatible endpoint ----
# OPENAI_API_KEY is only used when neither MAKERS_MODELS_KEY nor DEEPSEEK_API_KEY is set.
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# ---- Optional model routing overrides ----
# These override the provider defaults and must match a model available to that provider.
# AI_CHAT_MODEL=@makers/deepseek-v4-flash
# AI_PLANNING_MODEL=@makers/deepseek-v4-pro

# ---- Vision evidence checks ----
# Optional when VISION_API_KEY reuses DEEPSEEK_API_KEY or OPENAI_API_KEY.
VISION_API_KEY=
# VISION_MODEL=deepseek-flash
# VISION_BASE_URL=https://api.deepseek.com

# ---- Daily limits ----
DEMO_PLAN_DAILY_LIMIT=10
DEMO_VISION_DAILY_LIMIT=10
DEMO_REVIEW_DAILY_LIMIT=2
DEMO_GLOBAL_DAILY_LIMIT=100
DEMO_CHAT_RATE_PER_MINUTE=6

# ---- Production security ----
# Empty allows all origins for local demos. Set the exact deployed origins in production.
ALLOWED_ORIGINS=
# Strongly recommended in production; used when hashing anonymous quota identifiers.
QUOTA_HASH_SALT=

# ---- Build metadata overrides (usually supplied by CI/hosting) ----
# APP_VERSION=1.1.3
# BUILD_COMMIT=
# EDGEONE_COMMIT_SHA=
# GITHUB_SHA=
# COMMIT_SHA=
# EDGEONE_ENV=production
