# ---- EdgeOne Makers built-in models (optional) ----
# Create the key in EdgeOne Makers console -> Models -> API Key.
# When set, chat defaults to @makers/deepseek-v4-flash and
# planning defaults to @makers/deepseek-v4-pro.
MAKERS_MODELS_KEY=

# ---- Alternative: your own OpenAI-compatible text model ----
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# ---- Photo / vision evidence (required only for AI photo checks) ----
VISION_API_KEY=
# VISION_MODEL=deepseek-flash
# VISION_BASE_URL=https://api.deepseek.com

# ---- Model routing overrides ----
# Only set these when the corresponding model names are valid for your provider.
# AI_CHAT_MODEL=@makers/deepseek-v4-flash
# AI_PLANNING_MODEL=@makers/deepseek-v4-pro

# ---- Daily limits ----
DEMO_PLAN_DAILY_LIMIT=10
DEMO_VISION_DAILY_LIMIT=5
DEMO_REVIEW_DAILY_LIMIT=2

# Optional: comma-separated allowed origins. Empty means allow all origins.
ALLOWED_ORIGINS=
