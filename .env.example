# 必填：真实 AI 对话与证据判断
DEEPSEEK_API_KEY=
VISION_API_KEY=

# 每日额度
DEMO_PLAN_DAILY_LIMIT=10
DEMO_VISION_DAILY_LIMIT=5

# 可选：逗号分隔的允许来源；不填允许所有来源
ALLOWED_ORIGINS=

# 以下为代码默认值，通常不需要在 Netlify 环境变量中重复设置
# DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# VISION_MODEL=deepseek-flash
# VISION_BASE_URL=https://api.deepseek.com
